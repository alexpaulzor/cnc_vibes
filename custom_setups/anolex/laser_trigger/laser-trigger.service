# ~/.config/systemd/user/laser-trigger.service  (systemctl --user enable --now laser-trigger)
[Unit]
Description=Xbox controller hold-to-fire laser for cncjs
After=network.target

[Service]
ExecStart=%h/cnc_vibes/custom_setups/anolex/laser_trigger/.venv/bin/python %h/cnc_vibes/custom_setups/anolex/laser_trigger/laser_trigger.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
